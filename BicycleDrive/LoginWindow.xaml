<Window x:Class="BicycleDrive.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — ВелосипедДрайв"
        Width="660" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с логотипом -->
        <Border Grid.Row="0" Background="#6A5ACD">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Image Source="/Assets/icon.png" Width="84" Height="84"/>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="ВелосипедДрайв" Foreground="White"
                               FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="ООО «ВелосипедДрайв» · продажа техники для офиса"
                               Foreground="#E4DFF7" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1" Margin="90,34,90,0">
            <TextBlock Text="Вход в систему" FontSize="18" FontWeight="Bold"
                       Foreground="#4B0082" Margin="0,0,0,18"/>

            <TextBlock Text="Логин" FontSize="12.5" Foreground="#4B0082"/>
            <TextBox x:Name="LoginBox" Height="36" FontSize="14" Padding="8,6"
                     BorderBrush="#6A5ACD" BorderThickness="1" Margin="0,4,0,14"/>

            <TextBlock Text="Пароль" FontSize="12.5" Foreground="#4B0082"/>
            <PasswordBox x:Name="PasswordBox" Height="36" FontSize="14" Padding="8,6"
                         BorderBrush="#6A5ACD" BorderThickness="1" Margin="0,4,0,22"/>

            <Button x:Name="LoginButton" Content="Войти"
                    Height="42" Background="#4B0082" Foreground="White"
                    FontSize="15" FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand" Click="LoginClick"/>

            <Button x:Name="GuestButton" Content="Войти как гость"
                    Height="38" Background="#FFFFFF" Foreground="#4B0082"
                    BorderBrush="#6A5ACD" BorderThickness="1.4"
                    FontSize="13.5" Cursor="Hand" Margin="0,12,0,0"
                    Click="GuestClick"/>

            <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                       Margin="0,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
