<UserControl x:Class="BicycleDrive.SingleProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <Border Background="{Binding RowBackground}" BorderBrush="#D5D5E4" BorderThickness="0,0,0,1">
        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- ЗОНА 1: фото товара -->
            <Border Grid.Column="0" Width="120" Height="120" Background="#FFFFFF"
                    BorderBrush="#CFCFDE" BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="{Binding Photo}" Stretch="Uniform" Margin="4"/>
            </Border>

            <!-- ЗОНА 2: характеристики, цена и остаток -->
            <Grid Grid.Column="1" Margin="14,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                               Foreground="{Binding RowForeground}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CategoryLine}" FontSize="11.5"
                               Foreground="{Binding MutedForeground}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               Foreground="{Binding RowForeground}" TextWrapping="Wrap"
                               MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding ManufacturerLine}" FontSize="12"
                               Foreground="{Binding RowForeground}" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding SupplierLine}" FontSize="12"
                               Foreground="{Binding RowForeground}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding UnitLine}" FontSize="12"
                               Foreground="{Binding MutedForeground}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ArticleLine}" FontSize="11"
                               Foreground="{Binding MutedForeground}" Margin="0,5,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding OldPriceText}"
                               TextDecorations="Strikethrough" FontSize="13"
                               Foreground="{Binding OldPriceBrush}" VerticalAlignment="Bottom"
                               Margin="0,0,10,3" Visibility="{Binding OldPriceVisibility}"/>

                    <TextBlock Grid.Column="1" Text="{Binding FinalPriceText}" FontSize="22"
                               FontWeight="Bold" Foreground="{Binding FinalPriceBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="{Binding StockText}" FontSize="12"
                               Foreground="{Binding MutedForeground}" VerticalAlignment="Bottom"
                               HorizontalAlignment="Right" Margin="10,0,0,3"/>
                </Grid>
            </Grid>

            <!-- ЗОНА 3: действующая скидка -->
            <Border Grid.Column="2" BorderBrush="#B9B2D9" BorderThickness="1,0,0,0"
                    Padding="14,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Скидка" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{Binding MutedForeground}"/>
                    <TextBlock Text="{Binding DiscountValueText}" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,2,0,0"
                               Foreground="{Binding FinalPriceBrush}"/>
                    <TextBlock Text="{Binding DiscountHintText}" FontSize="11"
                               HorizontalAlignment="Center" Foreground="{Binding MutedForeground}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
