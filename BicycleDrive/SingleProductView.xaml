<UserControl x:Class="BicycleDrive.SingleProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Arial">
    <Border Background="{Binding RowBackground}" BorderBrush="#D5D5E4" BorderThickness="0,0,0,1">
        <Grid Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- ЗОНА 1: фото товара -->
            <Border Grid.Column="0" Width="120" Height="120" Background="#FFFFFF"
                    BorderBrush="#CFCFDE" BorderThickness="1" CornerRadius="4"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Image Source="{Binding Photo}" Stretch="Uniform" Margin="4"/>
            </Border>

            <!-- ЗОНА 2: характеристики -->
            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                           Foreground="{Binding RowForeground}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CategoryLine}" FontSize="11.5"
                           Foreground="{Binding MutedForeground}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Description}" FontSize="12"
                           Foreground="{Binding RowForeground}" TextWrapping="Wrap"
                           MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ManufacturerLine}" FontSize="12"
                           Foreground="{Binding RowForeground}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SupplierLine}" FontSize="12"
                           Foreground="{Binding RowForeground}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding UnitLine}" FontSize="12"
                           Foreground="{Binding MutedForeground}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding ArticleLine}" FontSize="11"
                           Foreground="{Binding MutedForeground}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ЗОНА 3: цена, скидка, остаток -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding OldPriceText}" TextDecorations="Strikethrough"
                           FontSize="13" Foreground="{Binding OldPriceBrush}"
                           HorizontalAlignment="Right"
                           Visibility="{Binding OldPriceVisibility}"/>
                <TextBlock Text="{Binding FinalPriceText}" FontSize="22" FontWeight="Bold"
                           Foreground="{Binding FinalPriceBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding DiscountText}" FontSize="12"
                           Foreground="{Binding MutedForeground}"
                           HorizontalAlignment="Right" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding StockText}" FontSize="12"
                           Foreground="{Binding MutedForeground}"
                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
