<Window x:Class="BicycleDrive.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар — ВелосипедДрайв"
        Width="640" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#6A5ACD">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/icon.png" Width="34" Height="34"/>
                    <TextBlock x:Name="HeaderText" Text="Товар" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Поля формы -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="IdLabel" Text="ID товара" FontSize="13"
                           Foreground="#4B0082" VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="0" x:Name="IdBox" FontSize="13" Padding="6,4"
                         IsReadOnly="True" Background="#F2EFFB" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Text="Артикул *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="1" x:Name="ArticleBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Text="Наименование *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="2" x:Name="NameBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Text="Категория *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="3" x:Name="CategoryBox" FontSize="13" Padding="6,4"
                          DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Text="Производитель *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="4" x:Name="ManufacturerBox" FontSize="13" Padding="6,4"
                          DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Text="Поставщик *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="5" x:Name="SupplierBox" FontSize="13" Padding="6,4"
                          DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Text="Единица измерения *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <ComboBox Grid.Row="6" x:Name="UnitBox" FontSize="13" Padding="6,4"
                          DisplayMemberPath="Name" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="7" Text="Цена, ₽ *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="7" x:Name="PriceBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                         ToolTip="Допускаются копейки, значение не может быть отрицательным"/>

                <TextBlock Grid.Row="8" Text="Количество на складе *" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="8" x:Name="QuantityBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                         ToolTip="Целое неотрицательное число"/>

                <TextBlock Grid.Row="9" Text="Действующая скидка, %" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,10"/>
                <TextBox Grid.Row="9" x:Name="DiscountBox" FontSize="13" Padding="6,4" Margin="0,0,0,10"
                         ToolTip="От 0 до 99,99"/>

                <TextBlock Grid.Row="10" Text="Описание" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Top" Margin="0,6,0,10"/>
                <TextBox Grid.Row="10" x:Name="DescriptionBox" FontSize="13" Padding="6,4"
                         Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="11" Text="Файл изображения" FontSize="13" Foreground="#4B0082"
                           VerticalAlignment="Center" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="11" Margin="0,0,0,4">
                    <TextBox x:Name="ImageBox" FontSize="13" Padding="6,4"
                             ToolTip="Имя файла в папке Images, например 1.jpg; пусто — picture.png"/>
                    <TextBlock Text="Пусто — будет использована заглушка picture.png" FontSize="11"
                               Foreground="#6B6B7B" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#F2EFFB" BorderBrush="#D5CCF0" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Button x:Name="DeleteButton" Content="Удалить" Click="DeleteClick"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="#C62828" Foreground="White" BorderThickness="0"
                        FontSize="13" Padding="18,8" Cursor="Hand"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Отмена" Click="CancelClick" IsCancel="True"
                            Background="#FFFFFF" Foreground="#4B0082" BorderBrush="#6A5ACD"
                            BorderThickness="1.2" FontSize="13" Padding="18,8"
                            Margin="0,0,10,0" Cursor="Hand"/>
                    <Button x:Name="SaveButton" Content="Сохранить" Click="SaveClick"
                            Background="#4B0082" Foreground="White" BorderThickness="0"
                            FontSize="13" Padding="20,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
